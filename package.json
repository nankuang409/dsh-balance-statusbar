{
  "name": "dsh-balance-statusbar",
  "version": "0.1.3",
  "description": "DeepSeek Harness (DSH) web GUI 底部状态栏插件：原会话统计条（轮数/步数 · LLM/工具时长 · 首 token · 解码吞吐 · 缓存命中 · 输入/输出 token）与 DeepSeek API 费用（总余额 · 今日消费 · 当前对话费用）合为一条。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node --check lib/pricing.js"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "balance",
    "quota",
    "usage",
    "cost",
    "statusbar",
    "stats",
    "web"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  }
}
